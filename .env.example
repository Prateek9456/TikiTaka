# Riot Games API key (required for Valorant/LoL ingestion)
RIOT_API_KEY=

# Riot Sign On (register at https://developer.riotgames.com/ — create an OAuth client)
# Add the redirect URI below in your Riot developer app settings.
RIOT_CLIENT_ID=
RIOT_CLIENT_SECRET=
RIOT_REDIRECT_URI=http://localhost/api/v1/auth/oauth/riot/callback
RIOT_DEFAULT_REGION=americas

# Prototype/demo: any Riot ID + tag links Valorant & LoL and fills dashboard with realistic sample data (no Riot API).
PROTOTYPE_DEMO=true

# CS2 ingestion via Faceit Open API (users link Faceit nickname or Steam in the app)
FACEIT_API_KEY=
# Faceit OAuth (register at https://developers.faceit.com/ — App Studio → OAuth2 Client)
# Redirect URI must match exactly (only one URI per client).
FACEIT_CLIENT_ID=
FACEIT_CLIENT_SECRET=
FACEIT_REDIRECT_URI=http://localhost/api/v1/auth/oauth/faceit/callback

# Steam OpenID login (API key optional but recommended for profile names/avatars)
# Realm must match the API origin; redirect URI must be registered in your Steam Web API key settings.
STEAM_API_KEY=
STEAM_REALM=http://localhost
STEAM_REDIRECT_URI=http://localhost/api/v1/auth/oauth/steam/callback

# Ingestion scheduler cron (Spring 6-field: second minute hour day month weekday)
# Every 2 min (default). For 1 min: 0 */1 * * * *
TIKITAKA_INGESTION_CRON=0 */2 * * * *

# Per-user match poller cron (default every 1 min)
TIKITAKA_USER_POLLER_CRON=0 */1 * * * *

# JWT secret (base64-encoded, min 256 bits)
JWT_SECRET=VGhpc0lzQVNlY3VyZUtleUZvclRpa2lUYWthQWlKd3RUb2tlbkVuY29kaW5nMTIzNDU2Nzg=

# OAuth token encryption key (base64-encoded 256-bit AES key for provider tokens at rest)
# Generate with: openssl rand -base64 32
OAUTH_TOKEN_ENCRYPTION_KEY=

# Frontend URLs for OAuth redirects (overridden by PUBLIC_APP_URL in production)
OAUTH_FRONTEND_REDIRECT_URL=http://localhost/auth/callback
OAUTH_LINK_REDIRECT_URL=http://localhost/settings/accounts
OAUTH_FRONTEND_LOGIN_URL=http://localhost/login

# Public site origin. On Render this is injected as the web service URL so OAuth
# callbacks become https://<app>/api/v1/auth/oauth/{google,riot,steam,faceit,epic}/callback
PUBLIC_APP_URL=
COOKIE_SECURE=false

# CORS allowed origins (comma-separated; defaults to localhost:3000 and localhost:5173)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://localhost

# SMTP for password-reset OTPs (optional in local dev; OTP is logged when unset)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@tikitaka.local

# Google OAuth (register at https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/api/v1/auth/oauth/google/callback

# Epic Games OAuth (register at https://dev.epicgames.com/portal — create a Product + Client)
# "Invalid client" means the Client ID is missing or not linked to an active application.
EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=
EPIC_REDIRECT_URI=http://localhost/api/v1/auth/oauth/epic/callback
# Optional: required for Ecommerce APIs; leave empty for basic sign-in only
EPIC_DEPLOYMENT_ID=

# --- GCP Cloud Run (see deploy/cloudrun/env.example and deploy/cloudrun/deploy.ps1) ---
# CLOUD_RUN=true
# KAFKA_ENABLED=false
# RUN_CELERY=false
# USE_CELERY_TASKS=false
# CLOUD_SQL_CONNECTION_NAME=project:region:instance
# REDIS_URL=rediss://...
# ALLOWED_HOSTS=your-api-xxxxx.run.app
# BACKEND_HOST=your-api-xxxxx.run.app

# --- Render (see render.yaml and deploy/render/env.example) ---
# External MYSQL_* + Upstash REDIS_URL; Blueprint wires PUBLIC_APP_URL and ML_SERVICE_URL.
