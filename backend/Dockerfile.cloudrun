FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    default-libmysqlclient-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

ENV PYTHONUNBUFFERED=1
ENV PORT=8080
ENV KAFKA_ENABLED=false
ENV RUN_KAFKA_CONSUMERS=false
ENV RUN_CELERY=false
ENV USE_CELERY_TASKS=false

EXPOSE 8080

COPY entrypoint.cloudrun.sh /entrypoint.cloudrun.sh
COPY entrypoint.job.sh /entrypoint.job.sh
RUN sed -i 's/\r$//' /entrypoint.cloudrun.sh /entrypoint.job.sh && \
    chmod +x /entrypoint.cloudrun.sh /entrypoint.job.sh

ENTRYPOINT ["/entrypoint.cloudrun.sh"]
