# Copy to Cloud Run service env (Console or gcloud). Local docker-compose.yml is unchanged.

# --- GCP ---
# GCP_PROJECT_ID=your-project
# GCP_REGION=us-central1
# CLOUD_SQL_CONNECTION_NAME=project:region:tikitaka-mysql

# --- Cloud Run (set on API + web services) ---
CLOUD_RUN=true
KAFKA_ENABLED=false
RUN_KAFKA_CONSUMERS=false
RUN_CELERY=false
USE_CELERY_TASKS=false

# Public UI URL (Cloud Run web service URL, no trailing slash)
PUBLIC_APP_URL=https://tikitaka-web-xxxxx-uc.a.run.app
COOKIE_SECURE=true
COOKIE_SAMESITE=None

# API hostname for Cloud Run (nginx proxies /api to this host; browser uses PUBLIC_APP_URL / web URL)
ALLOWED_HOSTS=tikitaka-api-xxxxx-uc.a.run.app,tikitaka-web-xxxxx-uc.a.run.app

# Frontend nginx proxies to API over HTTPS (hostname only, no https://)
BACKEND_HOST=tikitaka-api-xxxxx-uc.a.run.app

CORS_ALLOWED_ORIGINS=https://tikitaka-web-xxxxx-uc.a.run.app

# --- MySQL (Cloud SQL) ---
MYSQL_DATABASE=tikitaka
MYSQL_USER=tikitaka
MYSQL_PASSWORD=change-me
# When using Cloud SQL connector on Cloud Run, set CLOUD_SQL_CONNECTION_NAME instead of MYSQL_HOST.

# --- Redis (Upstash free tier example) ---
REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_HOST.upstash.io:6379
CELERY_BROKER_URL=rediss://default:YOUR_PASSWORD@YOUR_HOST.upstash.io:6379/1

# --- ML service (second Cloud Run service URL) ---
ML_SERVICE_URL=https://tikitaka-ml-xxxxx-uc.a.run.app

# --- OAuth (use PUBLIC_APP_URL origin + /api/v1/auth/oauth/...) ---
OAUTH_FRONTEND_REDIRECT_URL=https://tikitaka-web-xxxxx-uc.a.run.app/auth/callback
OAUTH_LINK_REDIRECT_URL=https://tikitaka-web-xxxxx-uc.a.run.app/settings/accounts
OAUTH_FRONTEND_LOGIN_URL=https://tikitaka-web-xxxxx-uc.a.run.app/login
GOOGLE_REDIRECT_URI=https://tikitaka-web-xxxxx-uc.a.run.app/api/v1/auth/oauth/google/callback
RIOT_REDIRECT_URI=https://tikitaka-web-xxxxx-uc.a.run.app/api/v1/auth/oauth/riot/callback
STEAM_REALM=https://tikitaka-web-xxxxx-uc.a.run.app
STEAM_REDIRECT_URI=https://tikitaka-web-xxxxx-uc.a.run.app/api/v1/auth/oauth/steam/callback
FACEIT_REDIRECT_URI=https://tikitaka-web-xxxxx-uc.a.run.app/api/v1/auth/oauth/faceit/callback
EPIC_REDIRECT_URI=https://tikitaka-web-xxxxx-uc.a.run.app/api/v1/auth/oauth/epic/callback

JWT_SECRET=
OAUTH_TOKEN_ENCRYPTION_KEY=
DJANGO_SECRET_KEY=
GUNICORN_WORKERS=1

# --- Cloud Run Job (ingestion) ---
# INGESTION_JOB=scheduled   # or poller
# Schedule with Cloud Scheduler → Job execute every 15–120 minutes
