# Render restricted deploy — set in Dashboard after Blueprint sync (or env group tikitaka-data).
# OAuth redirect URIs are derived from PUBLIC_APP_URL when not set explicitly (see settings).

# --- External MySQL (Render has no managed MySQL; use any MySQL host) ---
MYSQL_HOST=your-mysql-host.example.com
MYSQL_PORT=3306
MYSQL_DATABASE=tikitaka
MYSQL_USER=tikitaka
MYSQL_PASSWORD=

# --- Upstash Redis (free tier) ---
REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_HOST.upstash.io:6379
CELERY_BROKER_URL=rediss://default:YOUR_PASSWORD@YOUR_HOST.upstash.io:6379/1

# --- Secrets (required on tikitaka-api) ---
JWT_SECRET=base64-min-256-bits
OAUTH_TOKEN_ENCRYPTION_KEY=openssl-rand-base64-32

# --- Wired automatically by render.yaml ---
# ML_SERVICE_URL  <- tikitaka-ml RENDER_EXTERNAL_URL
# PUBLIC_APP_URL    <- tikitaka-web RENDER_EXTERNAL_URL
# BACKEND_HOST      <- tikitaka-api hostname (web service)
# WEB_HOSTNAME      <- tikitaka-web hostname (API ALLOWED_HOSTS)

# --- OAuth / game APIs (sync: false in Blueprint — add in Dashboard) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RIOT_API_KEY=
RIOT_CLIENT_ID=
RIOT_CLIENT_SECRET=
FACEIT_API_KEY=
FACEIT_CLIENT_ID=
FACEIT_CLIENT_SECRET=
STEAM_API_KEY=
EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=

# Register in provider consoles (browser uses web URL):
#   https://YOUR-WEB.onrender.com/api/v1/auth/oauth/google/callback
# STEAM_REALM=https://YOUR-WEB.onrender.com

# --- Optional overrides (defaults use PUBLIC_APP_URL) ---
# OAUTH_FRONTEND_REDIRECT_URL=
# GOOGLE_REDIRECT_URI=
